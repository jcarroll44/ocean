+  GPU.device[method]=desc=>{const out=original(desc);const data=serialize(desc);if(kind==='shader'){const id=hash(data.code);shaders[id]=data;objects.set(out,{kind,id});}else objects.set(out,{kind,descriptor:data});return out;};

diff --git a/scripts/check-pipeline-modules.mjs b/scripts/check-pipeline-modules.mjs
new file mode 100644
index 0000000..3a108e2
--- /dev/null
+++ b/scripts/check-pipeline-modules.mjs
@@ -0,0 +1,23 @@
+// Fast, strict WGSL precheck of EVERY module from the complete runtime graph.
+// Apple WebKit pipeline CI is a separate required release check.
+import fs from 'node:fs';import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {create,globals} from 'webgpu';Object.assign(globalThis,globals);
+const bytes=fs.readFileSync('.pipeline-check/manifest.json'),manifest=JSON.parse(bytes);
+const gpu=create(['backend=null']),adapter=await gpu.requestAdapter(),device=await adapter.requestDevice({requiredFeatures:manifest.features});
+const errors=[];
+for(const [id,descriptor] of Object.entries(manifest.shaders)){
+ device.pushErrorScope('validation');const info=await device.createShaderModule(descriptor).getCompilationInfo();
+ const scoped=await device.popErrorScope();
+ const messages=info.messages.filter(m=>m.type==='error').map(m=>m.message);if(scoped)messages.push(scoped.message);
+ if(messages.length)errors.push({id,label:descriptor.label,messages});
+}
+// The exact RC4 bug must be rejected by this validator, not just regex-checked.
+device.pushErrorScope('validation');
+const rejected=await device.createShaderModule({code:'@compute @workgroup_size(1) fn main(){ let coherent = true; }'}).getCompilationInfo();await device.popErrorScope();
+assert(rejected.messages.some(m=>m.type==='error'&&m.message.includes('reserved')),'Validator missed the RC4 reserved identifier');
+const result={backend:'Dawn strict WGSL (not Safari pipeline validation)',manifestHash:createHash('sha256').update(bytes).digest('hex'),modules:Object.keys(manifest.shaders).length,pipelines:manifest.pipelines.length,errors,passed:!errors.length};
+fs.writeFileSync('.pipeline-check/wgsl-report.json',JSON.stringify(result,null,2));
+fs.writeFileSync('night-report/weather-material-checks.json',JSON.stringify(result,null,2));
+device.destroy();assert.equal(errors.length,0,JSON.stringify(errors));
+console.log(`PASS: ${result.modules} actual shader modules; RC4 negative case rejected. Apple WebKit pipeline check still required.`);process.exit(0);

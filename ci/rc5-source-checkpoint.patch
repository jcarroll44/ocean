+const report=JSON.parse(fs.readFileSync(file));
+assert.equal(report.backend,'Apple WebKit WebGPU');
+assert.equal(report.manifestHash,createHash('sha256').update(bytes).digest('hex'),'Release blocked: Apple compiler evidence is stale');
+assert.equal(report.revision,manifest.revision);assert.equal(report.passed,true);

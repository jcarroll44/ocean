+const {FrameUniforms}=await import('../ocean-proof/vendor/tidewater/src/engine/render/Frame.js');
+const {Texture}=await import('../ocean-proof/vendor/tidewater/src/engine/gpu/Texture.js');
+const {installNativeWeather,guardNativeBreakerLip}=await import('../ocean-proof/proof/native-weather.js');
+const {installNativeBeach}=await import('../ocean-proof/proof/NativeBeachScene.js');
+const {installForecastSurf}=await import('../ocean-proof/proof/forecast-waves.js');
+const {installSmallSurf}=await import('../ocean-proof/proof/scene-polish.js');
+const {installWeatherSurfaces}=await import('../ocean-proof/proof/weather-surfaces.js');
+const {NativeOverlays}=await import('../ocean-proof/proof/NativeOverlays.js');
+const {BeachApp}=await import('../ocean-proof/proof/BeachApp.js');
+const {INTEGRATION_BUILD}=await import('../ocean-proof/proof/integration-build.js');
+const objects=new WeakMap(),pipelines=[],shaders={};
+const hash=s=>createHash('sha256').update(s).digest('hex');
+const serialize=v=>v&&typeof v==='object'?(objects.has(v)?objects.get(v):Array.isArray(v)?v.map(serialize):Object.fromEntries(Object.entries(v).map(([k,x])=>[k,serialize(x)]))):v;
+// Commands are traversed to build lazy pipelines, never executed or certified.
+const noops=new Proxy({},{get:()=>()=>{}});
+const encoder=new Proxy({beginComputePass:()=>noops,beginRenderPass:()=>noops,finish:()=>null},{get:(o,k)=>o[k]||(()=>{})});
+Engine.prototype.init=async function(){
+ await GPU.init({headless:true});
+ for(const [method,kind] of [['createShaderModule','shader'],['createBindGroupLayout','bindGroupLayout'],['createPipelineLayout','pipelineLayout']]){

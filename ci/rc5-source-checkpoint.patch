+assert.deepEqual(report.pipelines.map(p=>[p.kind,p.label]),manifest.pipelines.map(p=>[p.kind,p.descriptor.label]));
+console.log(`PASS: exact ${report.revision} Apple WebKit evidence matches all ${report.pipelines.length} pipelines. Not an iPhone FPS test.`);

+ for(const [method,kind] of [['renderPipeline','render'],['computePipeline','compute']])GPU[method]=desc=>{const descriptor=serialize(desc);pipelines.push({kind,descriptor});return{pipeline:{},label:desc.label,failed:false};};
+ this.canvas=this.domElement={width:585,height:1266,style:{}};
+ this.meshRenderer=new MeshRenderer();this.meshRenderer.syncPipelines=false;
+ this.camera=new PerspectiveCamera(62,390/844,.3,60000);this.scene=new Scene();
+ FrameUniforms.fields.outputResolution.value.set(585,1266);
+};
+const app=new BeachApp();
+app.configureNativeWeather=()=>{app.nativeWeather=installNativeWeather(app);};
+app.configureNativeShore=()=>{installSmallSurf(app.shore);app.forecastSurf=installForecastSurf(app.shore);};
+const prepare=app.precompile.bind(app);
+app.precompile=async()=>{
+ guardNativeBreakerLip(app.breakers);const provenVertex=app.breakers.mesh.material.vertex;
+ const beach=installNativeBeach(app);new NativeOverlays(app.scene);app.weatherSurfaces=installWeatherSurfaces(app,beach);
+ assert.equal(app.breakers.mesh.material.vertex,provenVertex,'BreakerLip vertex must retain the proven path');

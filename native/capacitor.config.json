{
  "appId": "com.jacobcarroll.daybuoy",
  "appName": "DayBuoy",
  "webDir": "www",
  "loggingBehavior": "none",
  "backgroundColor": "#edf4f5",
  "server": {
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "plugins": {},
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "preferredContentMode": "mobile",
    "webContentsDebuggingEnabled": false,
    "limitsNavigationsToAppBoundDomains": true
  }
}
